# Copy to .env and adjust. Loaded automatically when you run `python run.py`.
# Variables already set in the shell are not overridden (python-dotenv default).

STORAGE_PATH=./data
LISTEN_PORT=5000
FRAGMENT_SIZE_KB=64
MAX_UPLOAD_KB=1000

# LOG_LEVEL=INFO
# LOG_SYSLOG=false
# LOG_SYSLOG_ADDRESS=/dev/log

# HTTPS (optional)
# CERT_PATH=/path/to/cert.pem
# KEY_PATH=/path/to/key.pem
